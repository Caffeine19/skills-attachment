{
  "name": "skills-attachment",
  "displayName": "skills-attachment",
  "description": "Add Skills as native attachments in Copilot Chat Cmd+/ picker",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "publisher": "caffeinecat",
  "repository": {
    "type": "git",
    "url": "https://github.com/Caffeine19/skills-attachment.git"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "enabledApiProposals": [
    "chatContextProvider",
    "chatPromptFiles"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatContextProvider:skills"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatContext": [
      {
        "id": "skills",
        "icon": "$(lightbulb)",
        "displayName": "Skills"
      }
    ],
    "commands": [
      {
        "command": "skills-attachment.openSkill",
        "title": "Skills: Open Skill File"
      },
      {
        "command": "skills-attachment.refreshSkills",
        "title": "Skills: Refresh Skills"
      },
      {
        "command": "skills-attachment.showSkills",
        "title": "Skills: Show Discovered Skills"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --experimental-cli --write"
    ],
    "*.{json,md}": [
      "prettier --experimental-cli --write"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "effect": "^3.22.2"
  }
}
